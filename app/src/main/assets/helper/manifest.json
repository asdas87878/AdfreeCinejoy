{
  "manifest_version": 2,
  "name": "Viewer helper",
  "version": "1.0",
  "description": "Video controls, picture-in-picture layout and colour themes for the viewer app.",
  "browser_specific_settings": { "gecko": { "id": "helper@adfree.viewer" } },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"]
}
